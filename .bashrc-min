###################################################################
###                      bash_Command List                      ###
###################################################################

# Show Directory {{{
alias ..='cd ..;pwd'
# alias ls="ls --date '+%Y/%m/%d %H:%S'"
# alias ll="ls -la --date '+%Y/%m/%d %H:%S'"
# alias lll="ls -la --date '+%Y/%m/%d %H:%S'"
# alias lld="ls -la|greg -v \"^-\" |grep -v \"^l\"" 
# alias llg="lsd -la|grep -i ${1}"
# alias llsym="ls -la|grep ^l"


alias ls="ls --color=always" 
alias ll="ls -la --color=always"
alias lll="ls -la --color=always"
alias lld="ls -la --color=always|greg -v \"^-\" |grep -v \"^l\"" 
alias llg="lsd -la --color=always|grep -i ${1}"
alias llsym="ls -la --color=always|grep ^l"
# }}}

#Vim
alias vim='vi'

# Edit Setting RC File.
alias vimr="vi $HOME/.bashrc"
alias vimp="vi $HOME/.bash_profile"
alias vimvim="vi $HOME/.vimrc"


# Source Short Cut Setting
alias sor="source $HOME/.bashrc"
alias sop="source $HOME/.bash_profile"


#Charset Command
alias str="strings"
alias cha="nkf --guess"
alias od="god -tx1z"
alias hexdump="hexdump -C"
alias hd="hexdump -C"

alias line="wc -l"

#File Edit Confirmation
alias rm='rm -i'
alias rmdir='rm -vfr'

alias cp="cp -i"
alias mv="mv -i"


#Git Command
# alias gis='git status'
alias gil='git log --date=format:"%Y/%m/%d %H:%M:%S "'
alias gia='git add *'
alias gic='git commit'
alias gish='git push'
alias gill='git pull'
alias gif='git fetch'
alias gico='git checkout'
alias giff='git diff'
alias gigg='git grep'
alias gib='git branch'
alias gis='git switch'

if command -v tig >/dev/null 2>&1; then
    alias tis='tig status'
    alias til='tig log --date=format:"%Y/%m/%d %H:%M:%S"'
    alias tia='tig add *'
    alias tiff='tig show'
    alias tigg='tig grep'
fi


#alias du="du -sh ./*/ 2>/dev/null"
alias df="df -H"

alias gcc="gcc -g -O0"
alias cal="cal |lolcat -p 1"
alias ldd="otool -L"

# Network Command
alias ping="ping -c 10"
  #Confirm Network Interface Card

alias ip="curl ifconfig.me"


#Login User
alias id="id |sed -e 's/,\|\s/\n/g'"


#GNU Command {{{
alias grep="grep -n --color=auto"
alias gre="grep -n --color=auto"
alias gr="grep -n --color=auto"

alias sed="gsed"
alias stat="gstat"
alias date="gdate"
alias objdump="gobjdump"

# Fish Shell no need this Function.
function his() {
  if [[ $# == 0 ]]; then
    echo "引数なしでのhistory"
    history
  else
    history|grep "$1"
  fi
}


alias diff='diff -u'

#Backup Command
alias rsync="rsync -v"
