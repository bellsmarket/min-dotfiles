color_prompt() {
  local RESET="\[\e[0m\]"

  # ラベル
  local LABEL="\[\e[1;34m\]【サイト名】${RESET}"

  # ユーザー名@ホスト名 ／カレントディレクトリ
  local USER_HOST="\[\e[1;32m\]\u@\h"
  local CUR_DIR="\[\e[1;34m\]\w"

  # Git ブランチを (branch) の形で。ブランチが無ければ空文字列
  local GIT_COLOR="\[\e[31m\]"
  local GIT_BRANCH='$(
    b=$(git symbolic-ref --quiet --short HEAD 2>/dev/null) && printf " (%s)" "$b"
  )'

  # プロンプト末尾（$）と入力用スペース
  local PROMPT_TAIL="\[\e[32m\]\$ "

  # ───────────────────────────────────────────────
  export PS1="${LABEL}${USER_HOST} ${CUR_DIR}${GIT_COLOR}${GIT_BRANCH}${RESET}${PROMPT_TAIL}"
}

color_prompt 
